# 复制为 .env 后填入真实值。.env 已被 .gitignore 排除；本文件是模板，需要提交到 git。

# --- LLM（任何 OpenAI 兼容服务）---
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com

# --- 数据库 ---
# 留空则使用内存存储（重启丢失）。Postgres 支持在 Day 4 实现，配置了会启动报错
# 本地 compose：postgresql+asyncpg://aoki:aoki@localhost:5432/aoki
DATABASE_URL=

# --- Langfuse（留空则不追踪）---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 必须与项目所在区域一致，否则 401：
#   EU https://cloud.langfuse.com   US https://us.cloud.langfuse.com   JP https://jp.cloud.langfuse.com
LANGFUSE_HOST=https://jp.cloud.langfuse.com

# --- Agent ---
MAX_ITERATIONS=8
